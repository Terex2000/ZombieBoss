#ifndef SHOPSTATE_H
#define SHOPSTATE_H

#include <SFML/Graphics.hpp>
#include "State.h"
#include "StateManager.h"
#include "Shop.h"
#include "ShopView.h"
#include "SoundManager.h"
#include "TextureManager.h"
#include "InputManager.h"
#include "Player.h"


class ShopState : public State{
public:
    ShopState(sf::RenderWindow& window, StateManager* stateManager, SoundManager& soundManager,
              TextureManager& textureManager, InputManager& inputManager, Player& player);

    void handleInput(sf::RenderWindow& window, sf::Event event); // Gère les entrées utilisateur
    void update(sf::RenderWindow& window, double deltaTime); // Met à jour l'état
    void draw(sf::RenderWindow& window); // Dessine l'état

private:
    sf::RenderWindow& window;
    StateManager* stateManager;
    Shop shop;
    ShopView shopView;
    Player& player;
    bool exitShop;
};

#endif // SHOPSTATE_H
