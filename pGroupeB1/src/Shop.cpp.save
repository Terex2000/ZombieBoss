#include "Shop.h"
#include "HUDController.h"
#include "ShopView.h"
#


Shop::Shop(Player& player) : player(player) {}

// Shop.cpp
bool Shop::buyLife(HUDController& hudController, ShopView& shopView) {
    const int lifeCost = 50; // Exemple : 50 pièces
    if (player.getCoins() >= lifeCost) {
        player.addCoins(-lifeCost);
        player.gainLife();
        hudController.updateCoins(player.getCoins(), shopView); // Notifie les vues
        return true;
    }
    std::cerr << "Not enough coins!" << std::endl;
    return false;
}

bool Shop::upgradeDamage(HUDController& hudController, ShopView& shopView) {
    const int upgradeCost = 50; // Exemple : 50 pièces
    if (player.getCoins() >= upgradeCost) {
        player.addCoins(-upgradeCost);
        player.setBulletDamage(player.getBulletDamage() + 10);
        hudController.updateCoins(player.getCoins(), shopView); // Notifie les vues
        return true;
    }
    return false;
}

